# /etc/cron.d/PLUGINNAME: plugin crontab
# Unlike any other crontab you don't have to run the `crontab'
# command to install the new version when you edit this file
# and files in /etc/cron.d. These files also have username fields,
# that none of the other crontabs do.
#
# Documentation: 
# https://www.loxwiki.eu/pages/viewpage.action?pageId=23462653#Pluginf%C3%BCrdenLoxberryentwickeln(abVersion1.x)-Unterverzeichnis:cronYellowOptional
#

MAILTO=""
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# m h dom mon dow user  command
# 00:05 in the LoxBerry host timezone; only completed company-calendar days.
5 0 * * * loxberry flock -n /run/lock/timetracking-auto-close.lock docker exec backend python /app/scripts/auto_stop_missing_badges.py --completed-days >> /opt/loxberry/log/plugins/timetrackingplugin/auto_stop_missing_badges.log 2>&1
# One host trigger; never start a scheduler in each Gunicorn worker. The DB lease
# coalesces badge/correction notifications and enforces the configured interval.
* * * * * loxberry flock -n /run/lock/timetracking-loxone-sync.lock docker exec backend python /app/scripts/loxone_sync.py >> /opt/loxberry/log/plugins/timetrackingplugin/loxone_sync.log 2>&1
